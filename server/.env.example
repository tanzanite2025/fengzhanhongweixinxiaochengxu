# 运行环境: development | test | production
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
BASE_URL=http://localhost:3001

# 数据库连接 (开发默认 SQLite；生产可切 postgresql:// 或 mysql://)
DATABASE_URL="file:./dev.db"

# JWT 密钥 (生产环境务必使用 32 位以上随机强密钥)
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# 订单超时未支付自动关闭时间（分钟）
ORDER_EXPIRE_MINUTES=15

# 微信接口模式:
# - sandbox_mock: 仅允许在 development/test 下本地联调模拟微信登录/支付/发货回调
# - live: 生产与真实联调模式，强制校验以下全部微信官方凭证与证书
WECHAT_MODE=sandbox_mock

# 微信小程序与支付 V3 真实凭证（WECHAT_MODE=live 或 NODE_ENV=production 时必填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_CERT_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_PATH=
# 支持平台公钥或平台证书二选一，建议填写实际使用的验签密钥文件与序列号/公钥ID
WECHAT_PLATFORM_CERT_SERIAL_NO=
WECHAT_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
