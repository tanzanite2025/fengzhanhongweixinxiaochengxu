.cart-page {
  padding-bottom: 140rpx;
}

.cart-item {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #9ca3af;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.check-box-on {
  background-color: #111827;
  border-color: #111827;
  color: #ffffff;
}

.check-box-disabled {
  background-color: #e5e7eb;
}

.cart-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background-color: #e5e7eb;
  flex-shrink: 0;
}

.cart-info {
  flex: 1;
}

.cart-title {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.warn-text {
  color: #dc2626;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.cart-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.cart-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #f3f4f6;
  border-radius: 10rpx;
}

.qty-num {
  min-width: 36rpx;
  text-align: center;
}

.del-btn {
  font-size: 22rpx;
  color: #6b7280;
  margin-left: 8rpx;
}

.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-total {
  font-size: 36rpx;
}

.checkout-btn {
  background-color: #111827;
  color: #ffffff;
  padding: 0 40rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
