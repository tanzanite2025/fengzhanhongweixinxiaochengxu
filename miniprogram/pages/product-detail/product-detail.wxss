.detail-page {
  padding-bottom: 140rpx;
}

.banner {
  width: 100%;
  height: 700rpx;
  background-color: #e5e7eb;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.detail-head {
  margin: 20rpx 24rpx;
}

.detail-price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.detail-price {
  font-size: 42rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 12rpx;
}

.detail-sub {
  margin-top: 8rpx;
}

.card {
  margin: 20rpx 24rpx;
}

.spec-trigger, .shipping-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.spec-value, .shipping-text {
  font-size: 26rpx;
  color: #111827;
  max-width: 72%;
  text-align: right;
}

.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  padding: 16rpx 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.cart-icon-btn {
  width: 120rpx;
  text-align: center;
  font-size: 24rpx;
  color: #374151;
}

.action-add {
  flex: 1;
  background-color: #f3f4f6;
  color: #111827;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-weight: 600;
}

.action-buy {
  flex: 1;
  background-color: #111827;
  color: #ffffff;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.modal-panel {
  width: 100%;
  background-color: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
}

.modal-header {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-bottom: 28rpx;
}

.modal-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background-color: #e5e7eb;
}

.modal-price {
  font-size: 38rpx;
}

.modal-label {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sku-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background-color: #f3f4f6;
  font-size: 26rpx;
}

.sku-chip-active {
  background-color: #111827;
  color: #ffffff;
}

.sku-chip-disabled {
  opacity: 0.4;
}

.qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.qty-ctrl {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background-color: #f3f4f6;
  border-radius: 12rpx;
  font-weight: 700;
}

.qty-num {
  min-width: 40rpx;
  text-align: center;
}
