.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  background-color: #ffffff;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.search-btn {
  background-color: #111827;
  color: #ffffff;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.product-cover {
  width: 100%;
  height: 320rpx;
  background-color: #e5e7eb;
}

.product-info {
  padding: 16rpx;
}

.product-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
