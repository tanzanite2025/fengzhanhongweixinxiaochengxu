.cat-layout {
  display: flex;
  height: 100vh;
  background-color: #ffffff;
}

.cat-sidebar {
  width: 200rpx;
  background-color: #f3f4f6;
  height: 100%;
}

.cat-tab {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4b5563;
}

.cat-tab-active {
  background-color: #ffffff;
  color: #111827;
  font-weight: 700;
  border-left: 6rpx solid #111827;
}

.cat-content {
  flex: 1;
  padding: 20rpx;
  height: 100%;
  box-sizing: border-box;
}

.cat-item {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.cat-item-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background-color: #e5e7eb;
  flex-shrink: 0;
}

.cat-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cat-item-title {
  font-weight: 600;
  font-size: 28rpx;
}

.cat-item-price {
  font-size: 30rpx;
}
