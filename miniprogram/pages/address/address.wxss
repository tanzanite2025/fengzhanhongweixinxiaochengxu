.top-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.flex-btn {
  flex: 1;
}

.addr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.addr-name {
  font-weight: 700;
  font-size: 30rpx;
}

.default-tag {
  background-color: #111827;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.addr-detail {
  margin-top: 10rpx;
}

.addr-ops {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  font-size: 24rpx;
}

.op-link {
  color: #374151;
}

.op-del {
  color: #dc2626;
}

.form-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 99;
}

.form-panel {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.form-title {
  font-weight: 700;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.form-input {
  background-color: #f3f4f6;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 24rpx;
}

.form-btns {
  display: flex;
  gap: 16rpx;
}
